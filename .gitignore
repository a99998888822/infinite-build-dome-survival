# Godot 4+ specific ignores
.godot/
/android/
artifacts/ui_visual_audit/
tmp/
temp/
# Temporary reviews and validation output. Preserve art sources under
# artifacts/sources, reference, editable, generated, or the production assets tree.
artifacts/analysis/
artifacts/previews/
artifacts/reviews/
artifacts/validation/
artifacts/performance/
artifacts/maintenance/
# Disposable capture frames and logs; keep only curated review outputs.
artifacts/**/[0-9][0-9][0-9].png
artifacts/**/capture.log
artifacts/**/capture.err
# Runtime logs are regenerated by validation and capture tools.
artifacts/previews/**/*.log
# Python bytecode is disposable and must not be committed.
__pycache__/
*.py[cod]
# Godot generates these from the maintained localization CSV catalogs.
localization/**/*.translation
# Rebuildable localization review pages, captures, archives and validation reports.
artifacts/localization/
