# Godot 4+ specific ignores
.godot/
/android/
artifacts/ui_visual_audit/
tmp/
temp/
# Disposable capture frames and logs; keep only curated review outputs.
artifacts/**/[0-9][0-9][0-9].png
artifacts/**/capture.log
artifacts/**/capture.err
# Runtime logs are regenerated by validation and capture tools.
artifacts/previews/**/*.log
# Python bytecode is disposable and must not be committed.
__pycache__/
*.py[cod]
