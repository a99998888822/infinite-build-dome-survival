extends "res://scripts/tests/pixel_combat_effect_test.gd"

func _run() -> void:
	await setup([])
	var heard: Array = []
	AudioManager.combat_sfx_played.connect(func(cue, _path): heard.append(cue))
	var pool := FirePatch.spawn(host, Vector2.ZERO, null)
	await frames()
	check(AudioManager.get_node_or_null("FirePoolLoop") == null, "no fire-pool audio player is created")
	for cue in ["fire", "reaction_holy", "reaction_dark_flame"]:
		check(not AudioManager.play_combat_sfx(cue) and not AudioManager._play_combat_sfx_now(cue) and not AudioManager.play_sfx_path("res://assets/audio/sfx/combat/" + cue + "_01.wav"), "all playback APIs reject retired pool audio: " + cue)
	var impact := AudioManager.begin_combat_audio()
	check(not AudioManager.play_enchantment_sfx("fire") and not AudioManager.play_reaction_sfx("holy") and not AudioManager.play_reaction_sfx("dark_flame"), "pool enchantment and reactions are silent inside a contact batch")
	AudioManager.end_combat_audio()
	AudioManager.flush_combat_audio(true)
	check(impact.has_reaction and impact.requests.is_empty(), "silent reactions still mark the contact without queuing audio")
	await get_tree().create_timer(0.85).timeout
	check(is_instance_valid(pool) and heard.is_empty(), "pool persists silently beyond the former audio sample duration")
	var merged := FirePatch.spawn(host, Vector2(2, 0), null)
	pool.expand_from_wind()
	check(merged == pool and heard.is_empty(), "merging and spreading pools remain silent")
	var second := FirePatch.spawn(host, Vector2(1000, 0), null)
	await frames()
	check(heard.is_empty() and get_tree().get_nodes_in_group("fire_patches").size() == 2, "separate pools remain silent")
	FirePatch.tint_nearby_fields(get_tree(), second.global_position, 40, 1, 3)
	FirePatch.tint_nearby_fields(get_tree(), pool.global_position, 40, 2, 3)
	await frames()
	check(heard.is_empty() and second._visual_palette == 1 and pool._visual_palette == 2, "holy and dark pools keep their visuals without burning audio")
	GameGlobal.set_runtime_flag("battle_runtime_paused", true)
	await frames()
	check(heard.is_empty(), "pausing does not play pool audio")
	GameGlobal.set_runtime_flag("battle_runtime_paused", false)
	await frames()
	check(heard.is_empty(), "resuming does not restart retired pool audio")
	pool.queue_free()
	await frames()
	check(is_instance_valid(second) and heard.is_empty(), "remaining pool stays silent")
	second._remaining = 0.01
	await frames()
	check(not is_instance_valid(second) and heard.is_empty(), "last pool expires silently")
	FirePatch.spawn(host, Vector2.ZERO, null)
	await frames()
	AudioManager.stop_combat_sfx()
	check(heard.is_empty(), "new pools and explicit audio cleanup remain silent")
	host.queue_free()
	await frames()
	check(heard.is_empty() and AudioManager._combat_players.all(func(p): return not p.playing), "scene cleanup leaves no fire audio running")
	print("FIRE_POOL_AUDIO_TEST checks=",checks," failures=",failures)
	get_tree().quit(1 if failures else 0)
