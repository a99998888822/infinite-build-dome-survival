[node name="SummaryLabel" type="Label" parent="CenterContainer/MainPanel/Content"]
text = "当前区域信息"
autowrap_mode = 3

[node name="ZoneCardGrid" type="GridContainer" parent="CenterContainer/MainPanel/Content"]
columns = 3

[node name="HintLabel" type="Label" parent="CenterContainer/MainPanel/Content"]
text = "同一区域会继续积累福缘；切换区域会触发收割。"
horizontal_alignment = 1
autowrap_mode = 3
