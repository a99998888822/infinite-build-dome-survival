[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/zone_select_popup.gd" id="1_zone_select_popup"]

[node name="ZoneSelectPopup" type="Control"]
script = ExtResource("1_zone_select_popup")

[node name="CenterContainer" type="CenterContainer" parent="."]

[node name="MainPanel" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(1040, 620)

[node name="Content" type="VBoxContainer" parent="CenterContainer/MainPanel"]
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="CenterContainer/MainPanel/Content"]
