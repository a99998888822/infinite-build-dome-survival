[sub_resource type="Shader" id="ShaderRarityGlow"]
code = "shader_type canvas_item;\nuniform vec4 glow_color : source_color = vec4(0.42, 0.78, 0.32, 1.0);\nuniform float intensity = 0.18;\n\nvoid fragment() {\n    vec2 centered = UV - vec2(0.5);\n    float distance_to_center = length(centered) * 1.41421356;\n    float falloff = 1.0 - smoothstep(0.08, 1.0, distance_to_center);\n    COLOR = vec4(glow_color.rgb, falloff * glow_color.a * intensity);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterialRarityGlow"]
